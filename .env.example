# إعدادات بوت التليجرام
BOT_TOKEN=ضع_توكن_البوت_هنا_من_BotFather
CHANNEL_ID=@اسم_قناتك_او_الايدي_مثلا_-1001234567890
ADMIN_IDS=123456789,987654321  # ايديات المشرفين مفصولة بفاصلة

# إعدادات الذكاء الاصطناعي (اختياري لكن مفضل)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1  # يمكنك تغييره لـ Groq / OpenRouter

# إعدادات النشر
TIMEZONE=Asia/Riyadh
EDUCATION_POST_TIMES=10:00,18:00  # أوقات نشر المنشورات التعليمية
NEWS_POST_TIMES=08:00,14:00,20:00  # أوقات ملخص الأخبار
ECONOMIC_CALENDAR_CHECK_INTERVAL=60  # كل كم دقيقة يفحص التقويم (دقيقة)

# إعدادات المحتوى
LANGUAGE=ar
ENABLE_AI_GENERATION=True
ENABLE_ECONOMIC_NEWS=True
ENABLE_EDUCATION=True

# مصادر الأخبار (اختياري)
NEWS_API_KEY=
FRED_API_KEY=
